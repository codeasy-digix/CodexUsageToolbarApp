"auto.help.what" = "उपयोग की जाँच केवल स्थिति पढ़ती है। यह वैकल्पिक सुविधा योग्य खातों को एक छोटा, यादृच्छिक अंकगणितीय अनुरोध भेजती है, ताकि ऐप चलने के दौरान उनकी 5h उपयोग अवधि शुरू होती रहे।";
"auto.help.schedule" = "सफल अनुरोध के बाद उसी खाते का अगला अनुरोध शुरुआत से 5 घंटे बाद तय होता है। एक समय में केवल एक खाता चलता है और खातों की शुरुआत में कम से कम 30 मिनट का अंतर होता है। स्लीप या पुनः शुरू होने पर छूटे हुए अनुरोध एक साथ नहीं, अंतर देकर भेजे जाते हैं।";
"auto.help.cost" = "यह असली मॉडल अनुरोध है और Codex की उपलब्ध सीमा खर्च करता है। यह डिफ़ॉल्ट रूप से बंद है। उपलब्ध हल्के मॉडल को प्राथमिकता मिलती है और समर्थित होने पर कम रीजनिंग स्तर उपयोग होता है; हल्का मॉडल न मिलने पर अन्य उपलब्ध मॉडल या रनटाइम का डिफ़ॉल्ट मॉडल उपयोग होता है। यह क्रेडिट नहीं बढ़ाता और OpenAI को सीमा रीसेट करने के लिए बाध्य नहीं कर सकता; रीसेट समय और सीमा OpenAI के नियंत्रण में हैं।";
"auto.help.limits" = "केवल वे जुड़े खाते योग्य हैं जिनकी अंतिम सफल स्थिति में 5h सीमा है। केवल साप्ताहिक सीमा वाले, न जुड़े या साइन इन की प्रतीक्षा कर रहे खाते छोड़ दिए जाते हैं। विफल स्वचालित अनुरोध के बाद फिर प्रयास करने से पहले कम से कम 30 मिनट इंतज़ार होता है। ऐप अनुरोध या टोकन रीफ़्रेश की सफलता की गारंटी नहीं देता।";
"auto.help.devices" = "ऐप बंद होने पर अनुरोध रुक जाते हैं। एक ही खातों के लिए यह सुविधा केवल एक Mac पर चालू रखें, ताकि मॉडल अनुरोध दोहराए न जाएँ। खाते का प्रमाणीकरण आपको ही पूरा करना होगा।";
"auto.help.privacy" = "स्वचालित अनुरोध में केवल गणित का सवाल होता है। जानबूझकर दस्तावेज़ नहीं जोड़े जाते। शामिल Codex रनटाइम OpenAI से संवाद करता है और चुने गए CODEX_HOME की सेटिंग अपनाता है; अपने कस्टम प्रदाताओं, MCP सर्वरों या रनटाइम टेलीमेट्री सेटिंग की समीक्षा करें।";
"about.title" = "इस उत्पाद के बारे में";
"about.version" = "संस्करण %@ (%@)";
"about.overview" = "एक मेन्यू बार पैनल में कई Codex खातों और वर्कस्पेस पर नज़र रखें। मुख्य लॉगिन बदले बिना 5h और साप्ताहिक शेष सीमा, रीसेट समय और रीसेट क्रेडिट देखें।";
"about.accounts" = "इस Mac का डिफ़ॉल्ट कनेक्शन मौजूदा .codex लॉगिन का उपयोग करता है। अतिरिक्त खाते/वर्कस्पेस ऐप द्वारा सँभाले गए अलग Codex फ़ोल्डर इस्तेमाल करते हैं। नाम और दिखने का क्रम स्थानीय रूप से सहेजे जाते हैं।";
"about.refresh" = "पैनल खोलने पर हर कनेक्शन जाँचा जाता है। वैकल्पिक 5h ऑटो-रीफ़्रेश ऐप चलने पर हल्के गणितीय अनुरोध खातों के बीच अंतर देकर भेजता है। असली अनुरोध सीमा खर्च करते हैं और OpenAI की सीमाओं को बदल नहीं सकते।";
"about.privacy" = "इस ऐप में डेवलपर का खाता सर्वर, विज्ञापन SDK या ऐप विश्लेषण अपलोड नहीं है। यह डेवलपर को लॉगिन जानकारी या उपयोग डेटा नहीं भेजता। प्रमाणीकरण, स्थिति की जाँच और वैकल्पिक मॉडल अनुरोधों के लिए फिर भी OpenAI से संवाद ज़रूरी है। शामिल रनटाइम और उपयोगकर्ता द्वारा सेट किए गए एंडपॉइंट का अपना नेटवर्क व्यवहार होता है।";
"about.opensource" = "Codex Usage, MIT लाइसेंस के अंतर्गत ओपन सोर्स है। शामिल OpenAI Codex रनटाइम Apache License 2.0 के अंतर्गत है। यह स्वतंत्र परियोजना है, OpenAI का आधिकारिक उत्पाद नहीं। OpenAI, ChatGPT और Codex उनके मालिकों के ट्रेडमार्क हैं।";
"about.repository" = "स्रोत कोड";
